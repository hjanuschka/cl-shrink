#!/usr/bin/env bash
#
# cl-shrink -- reclaim disk in gclient-managed Chromium checkouts by
# re-deltifying the git object stores of their third_party repositories.
#
#   cl-shrink ~/chromium
#   cl-shrink --dry-run ~/chromium ~/chromium_2 ~/chromium_3
#
# gclient fetches incrementally, so every sync appends a thin pack whose
# deltas are never recomputed against the rest of the history. `repack -f`
# rebuilds the delta chains from scratch; measured 54-68% reclaim on
# skia/tflite. Anything removed here is restored by `gclient sync`.

set -uo pipefail
trap 'kill 0 2>/dev/null; exit 130' INT TERM

AGGRESSIVE=0
DRY_RUN=0
FORCE=0
INCLUDE_LOCAL=0
MIN_SIZE_MB=20
MAX_PACK_GB=0 # 0 = no limit
TOP_LEVEL=0

usage() {
  cat >&2 <<'EOF'
usage: cl-shrink [options] <checkout-root>...

options:
  -n, --dry-run        report sizes and exit without touching anything
  -a, --aggressive     --window=250 --depth=50; ~7% smaller, ~4x the CPU
  -f, --force          re-process repos already shrunk since their last fetch
      --include-local  also prune tags/reflogs in repos holding local commits
                       (default: those are repacked but never pruned)
      --min-size MB    skip repos with a .git smaller than this (default 20)
      --max-pack GB    skip repos whose largest pack exceeds this (default none)
EOF
  exit 2
}

ROOTS=()
while (($#)); do
  case $1 in
  -n | --dry-run) DRY_RUN=1 ;;
  -a | --aggressive) AGGRESSIVE=1 ;;
  -f | --force) FORCE=1 ;;
  --include-local) INCLUDE_LOCAL=1 ;;
  --min-size)
    MIN_SIZE_MB=${2:?}
    shift
    ;;
  --max-pack)
    MAX_PACK_GB=${2:?}
    shift
    ;;
  --top-level) TOP_LEVEL=1 ;;
  -h | --help) usage ;;
  -*) usage ;;
  *) ROOTS+=("$1") ;;
  esac
  shift
done
((${#ROOTS[@]})) || usage

STAMP=cl-shrink-stamp
du_kb() { du -sk "$1" | cut -f1; }
free_kb() { df -Pk "$1" | awk 'NR==2 {print $4}'; }

# Largest pack decides peak extra disk: repack writes the new pack before
# unlinking the old one.
largest_pack_kb() {
  du -k "$1"/objects/pack/*.pack 2>/dev/null | sort -rn | head -1 | cut -f1
}

has_local_commits() {
  [[ -n $(git -C "$1" log --branches --not --remotes --format=%h -1 2>/dev/null) ]] ||
    [[ -n $(git -C "$1" stash list 2>/dev/null) ]]
}

# A gclient solution root (<checkout>/src, <checkout>/angle, ...) rather than a
# dependency pulled in by DEPS. These hold your branches and dwarf everything
# else, so they are opt-in and go last.
is_solution_repo() {
  local repo=$1 root
  for root in "${ROOTS[@]}"; do
    [[ ${repo%/*} == "${root%/}" ]] && return 0
  done
  return 1
}

# A stamp newer than every pack means nothing was fetched since the last run.
already_shrunk() {
  local git_dir=$1 stamp=$git_dir/$STAMP
  [[ -f $stamp ]] || return 1
  [[ -z $(find "$git_dir/objects/pack" -name '*.pack' -newer "$stamp" -print -quit 2>/dev/null) ]]
}

for root in "${ROOTS[@]}"; do
  [[ -d $root ]] || {
    echo "cl-shrink: no such directory: $root" >&2
    exit 1
  }
done

if pgrep -af 'gclient|autoninja|\bsiso\b' | grep -qv "$$"; then
  echo "cl-shrink: a gclient sync or build looks active; refusing to run" >&2
  exit 1
fi

printf 'scanning for git repositories...\n'
mapfile -t GIT_DIRS < <(
  find "${ROOTS[@]}" \
    \( -name out -o -name node_modules -o -name .cipd \) -prune -o \
    -name .git -type d -print 2>/dev/null | sort
)
printf 'found %d repositories\n\n' "${#GIT_DIRS[@]}"

# Dependencies first: their reclaimed space is what lets a solution repo clear
# the headroom check later in the same run.
DEPS=() SOLUTIONS=()
for git_dir in "${GIT_DIRS[@]}"; do
  if is_solution_repo "${git_dir%/.git}"; then
    SOLUTIONS+=("$git_dir")
  else
    DEPS+=("$git_dir")
  fi
done

total_before=0 total_after=0 processed=0 skipped=0
start=$SECONDS

for git_dir in "${DEPS[@]}" "${SOLUTIONS[@]}"; do
  repo=${git_dir%/.git}
  label=${repo#"$HOME"/}
  before=$(du_kb "$git_dir")
  solution=0
  is_solution_repo "$repo" && solution=1

  if ((solution && !TOP_LEVEL)); then
    printf '  skip  %-60s solution repo (--top-level to include)\n' "$label"
    ((skipped++))
    continue
  fi

  if ((before < MIN_SIZE_MB * 1024)); then
    ((skipped++))
    continue
  fi
  if ! ((FORCE)) && already_shrunk "$git_dir"; then
    printf '  skip  %-60s already shrunk\n' "$label"
    ((skipped++))
    continue
  fi

  pack_kb=$(largest_pack_kb "$git_dir")
  pack_kb=${pack_kb:-0}
  if ((MAX_PACK_GB > 0 && pack_kb > MAX_PACK_GB * 1048576)); then
    printf '  skip  %-60s pack %.1f GB over --max-pack\n' "$label" "$((pack_kb / 1024))e-3"
    ((skipped++))
    continue
  fi
  # `repack -a` rewrites every pack, so peak usage is the current store plus the
  # largest pack it must reproduce. Geometric repack only rolls up the small
  # per-fetch packs, so it needs a fraction of that and is the fallback for a
  # solution repo too big to rewrite in place.
  avail=$(free_kb "$git_dir")
  geometric=0
  if ((avail < pack_kb + 2097152)); then
    if ((solution)); then
      geometric=1
    else
      printf '  SKIP  %-60s needs %d GB free, have %d GB\n' \
        "$label" "$(((pack_kb + 2097152) / 1048576))" "$((avail / 1048576))"
      ((skipped++))
      continue
    fi
  fi

  total_before=$((total_before + before))
  prune=1
  if ((geometric)) || (has_local_commits "$repo" && ! ((INCLUDE_LOCAL))); then
    prune=0
  fi

  if ((geometric)); then
    plan='geometric (too big to rewrite, rolling up fetch packs)'
  elif ((prune)); then
    plan='repack+prune'
  else
    plan='repack only (local commits)'
  fi

  if ((DRY_RUN)); then
    printf '  %-62s %6.2f GB  %s\n' "$label" "$((before * 100 / 1048576))e-2" "$plan"
    ((processed++))
    continue
  fi

  printf '  %-62s %6.2f GB -> ' "$label" "$((before * 100 / 1048576))e-2"

  if ((prune)); then
    git -C "$repo" for-each-ref --format='delete %(refname)' refs/tags |
      git -C "$repo" update-ref --stdin
    git -C "$repo" reflog expire --expire=now --expire-unreachable=now --all
  fi

  if ((geometric)); then
    repack_args=(--geometric=2 -d --quiet)
  else
    repack_args=(-a -d -f --quiet)
    ((AGGRESSIVE)) && repack_args+=(--window=250 --depth=50)
  fi
  if ! git -C "$repo" repack "${repack_args[@]}"; then
    printf 'FAILED (left intact)\n'
    rm -f "$git_dir"/objects/pack/tmp_pack_* 2>/dev/null
    total_after=$((total_after + before))
    continue
  fi
  ((prune)) && git -C "$repo" prune --expire=now 2>/dev/null

  after=$(du_kb "$git_dir")
  total_after=$((total_after + after))
  : >"$git_dir/$STAMP"
  printf '%6.2f GB  (-%d%%)\n' "$((after * 100 / 1048576))e-2" \
    "$(((before - after) * 100 / before))"
  ((processed++))
done

printf '\n%d repositories processed, %d skipped, %dm elapsed\n' \
  "$processed" "$skipped" "$(((SECONDS - start) / 60))"
if ((DRY_RUN)); then
  printf 'candidate .git total: %.1f GB -- expect 50-65%% reclaim (%.0f-%.0f GB)\n' \
    "$((total_before * 10 / 1048576))e-1" \
    "$((total_before / 2097152))" "$((total_before * 65 / 104857600))"
else
  printf 'before %.1f GB -> after %.1f GB, reclaimed %.1f GB\n' \
    "$((total_before * 10 / 1048576))e-1" "$((total_after * 10 / 1048576))e-1" \
    "$(((total_before - total_after) * 10 / 1048576))e-1"
fi
